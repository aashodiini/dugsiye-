# Copy to .env and fill in the passwords chosen when running scripts/db/setup.sql.

# Table owner: used by `prisma migrate` only.
MIGRATION_DATABASE_URL="postgresql://dugsiye_owner:PASSWORD@localhost:5432/dugsiye_dev"

# Bound by row-level security: used only through forSchool().
APP_DATABASE_URL="postgresql://dugsiye_app:PASSWORD@localhost:5432/dugsiye_dev"

# BYPASSRLS: used only by platform services.
PLATFORM_DATABASE_URL="postgresql://dugsiye_platform:PASSWORD@localhost:5432/dugsiye_dev"

# The same three, against the test database.
TEST_MIGRATION_DATABASE_URL="postgresql://dugsiye_owner:PASSWORD@localhost:5432/dugsiye_test"
TEST_APP_DATABASE_URL="postgresql://dugsiye_app:PASSWORD@localhost:5432/dugsiye_test"
TEST_PLATFORM_DATABASE_URL="postgresql://dugsiye_platform:PASSWORD@localhost:5432/dugsiye_test"
